<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- App theme: Compose draws everything; this only sets the window around it. -->
    <style name="Theme.ZorixChess" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/zorix_background</item>
        <item name="android:colorAccent">@color/zorix_red</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>

    <!-- Launch theme: system splash (Android 12+) / compat splash showing the ZC emblem. -->
    <style name="Theme.ZorixChess.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/zorix_background</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_icon</item>
        <item name="windowSplashScreenAnimationDuration">300</item>
        <item name="postSplashScreenTheme">@style/Theme.ZorixChess</item>
    </style>

</resources>
