# Postgres (Vercel: Storage -> Neon -> connect to the project; it sets DATABASE_URL).
DATABASE_URL=postgres://user:password@host/db?sslmode=require

# The one administrator. Logging in with this email and password opens the admin panel.
ADMIN_EMAIL=you@example.com
ADMIN_PASSWORD=change-me

# Email for verification and password-reset codes (Gmail: an App Password, not the account password).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=you@gmail.com
SMTP_PASS=xxxx xxxx xxxx xxxx
MAIL_FROM="Zorix Chess <you@gmail.com>"

# Public address of the site (used in emails and invite links).
NEXT_PUBLIC_SITE_URL=https://zorixchess.vercel.app
