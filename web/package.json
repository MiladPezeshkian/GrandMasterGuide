    "nodemailer": "10.0.10",
    "postgres": "3.4.9",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "0.0.1",
    "stockfish": "19.0.0",
    "three": "0.186.1",
    "zod": "4.6.5"
  },
